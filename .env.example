# Copy this file to `.env` (same directory) and fill in real values.
# `.env` is gitignored — never commit real secrets.
#
# If no .env file exists and APP_ENV is unset, the app behaves exactly like
# the original local XAMPP defaults (APP_ENV=local, dev OTP exposed, etc).

# ── Environment ──────────────────────────────────────────────────────────
# local | production
APP_ENV=production

# Public base URL the API is served at (no trailing slash)
APP_BASE_URL=https://prescriptionrx.in

# true/false — verbose PHP error display. Leave false in production.
APP_DEBUG=false

APP_TIMEZONE=UTC
APP_VERSION=v1

# MUST be false in production. OTP responses only include `dev_otp` when
# true — that's a local-testing convenience while SMS/e-mail delivery isn't
# wired up yet. Never enable this on a public/production deployment.
EXPOSE_DEV_OTP=false

# ── Database (MySQL/MariaDB) ─────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=your_prod_db
DB_USER=your_prod_user
DB_PASS=your_prod_password
DB_CHARSET=utf8mb4

# ── JWT ───────────────────────────────────────────────────────────────────
# Generate a strong random value, e.g.: php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
JWT_ALGO=HS256
JWT_EXPIRY=3600
JWT_REFRESH_EXPIRY=604800

# ── Uploads ───────────────────────────────────────────────────────────────
UPLOAD_MAX_SIZE=5242880

# ── Logging ───────────────────────────────────────────────────────────────
# debug | info | warning | error
LOG_LEVEL=error

# ── Rate limiting ─────────────────────────────────────────────────────────
# db | file
RATE_LIMIT_STORAGE=db

# ── SMS / e-mail provider (not wired up in code yet — reserved for when
#    real OTP delivery is added; safe to leave blank until then) ──────────
SMS_PROVIDER=
SMS_API_KEY=
SMS_API_SECRET=
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=
